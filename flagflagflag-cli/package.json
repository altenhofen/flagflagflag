{
  "name": "flagflagflag-cli",
  "version": "0.0.1",
  "description": "Interactive CLI for flagflagflag feature flags.",
  "type": "module",
  "bin": {
    "flagflagflag": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "pnpm --dir ../flagflagflag-ts-sdk build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --dir ../flagflagflag-ts-sdk build",
    "test": "vitest run"
  },
  "dependencies": {
    "@flagflagflag/ts-sdk": "file:../flagflagflag-ts-sdk",
    "ink": "^6.0.1",
    "ink-text-input": "^6.0.0",
    "react": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
